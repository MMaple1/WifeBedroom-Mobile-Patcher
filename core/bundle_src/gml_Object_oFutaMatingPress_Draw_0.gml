            }
            draw_set_halign(fa_center);
            draw_set_color(c_white);
            draw_text_ext_transformed(label_x, base_y + 3, s_labels[i], 12, 100, 0.5, 0.5, 0);
            var ratio = clamp((current_val - s_mins[i]) / (s_maxs[i] - s_mins[i]), 0, 1);
            var knob_x = slider_x + (ratio * slider_w);
            draw_rectangle_color(slider_x, base_y + 4, slider_x + slider_w, base_y + 3 + slider_h, c_gray, c_gray, c_gray, c_gray, false);
            draw_rectangle_color(slider_x, base_y + 4, knob_x, base_y + 3 + slider_h, c_white, c_white, c_white, c_white, false);
            draw_circle_color(knob_x, base_y + 3 + (slider_h / 2), 3, c_white, c_white, false);

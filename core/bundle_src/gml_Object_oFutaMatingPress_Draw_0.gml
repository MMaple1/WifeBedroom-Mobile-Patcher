            var is_inputting = customize_selected_input == s_inputs[i];
            var btn_color = is_inputting ? 65535 : 16777215;
            draw_sprite_ext(sButtonBack, 1, input_x, base_y + 5, 1.8, 1, 0, btn_color, 0.5 + (0.5 * input_hover) + (0.5 * is_inputting));

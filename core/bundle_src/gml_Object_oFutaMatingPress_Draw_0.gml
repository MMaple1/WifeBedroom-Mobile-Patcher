    comment = "layer 2: boobs (dynamic size and jiggle)";
    var _boob_y = ((portrait_y + (top_breath * 64) + 12) - (12 * top_boob_size)) + top_boob_jiggle;
    var _boob_xscale = (1 + top_breath) * min(1.1, top_boob_size);
    var _boob_yscale = (1 - top_breath) * top_boob_size;
    var _is_vanilla = top_sprite != custom_mating_press && top_sprite != legacy_custom_mating_press;
    var _use_alt_boobs = _is_vanilla && futa_boob_index > 0;
    var _use_alt_clothing = _use_alt_boobs && top_sprite != sFutaMatingPressAlien;

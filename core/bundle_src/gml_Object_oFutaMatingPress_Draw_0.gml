    {
        ball_size: 0.05,
        top_penis_length: 0,
        top_penis_width: 0.05
    };
    if (edge_lover_pill)
    {
        ball_size += m_el.ball_size;
        top_penis_length += m_el.top_penis_length;
        top_penis_width += m_el.top_penis_width;
    }
    else
    {
        ball_size -= m_el.ball_size;
        top_penis_length -= m_el.top_penis_length;
        top_penis_width -= m_el.top_penis_width;
        edge_lover_threshold = 0;

    comment = "layer 12: horns / ears (mapped to vanilla index 8)";
    draw_sprite_ext(_lover_base_portrait, (top_sprite == custom_mating_press && top_sprite != legacy_custom_mating_press) ? 12 : 8, portrait_x + (face_x / 2), portrait_y + (top_breath * 64) + (face_y / 2), 1 * custom_portrait_scale, 1 * custom_portrait_scale, 0, top_skin, 1);

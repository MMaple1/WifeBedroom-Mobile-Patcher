            draw_sprite_ext(sButtonBack, 1, input_txt_l, row_txt_y + 2, 1.8, 1, 0, text_lover_btn_input ? c_yellow : c_white, 0.5 + (0.5 * text_slider_lover) + (0.5 * text_lover_btn_input));

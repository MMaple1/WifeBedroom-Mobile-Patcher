        }
        if (mouse_check_button_pressed(mb_left) && dlg_wife_hover && !title)
        {
            dlg_color_picker_active = 2;
            dlg_current_color = oDialogueManager.wife_dialogue_color;
            dlg_preview_color = oDialogueManager.wife_dialogue_color;
            dlg_picker_value = color_get_hue(oDialogueManager.wife_dialogue_color);
            dlg_last_picker_value = -1;
        }
        if (dlg_color_picker_active > 0)
        {
            var dcpw_x = (room_width / 2) + 77;
            var dcpw_y = (room_height / 2) - 100;
            var dcpw_res = 100;
            draw_sprite_ext(sButtonBack, 0, dcpw_x + (dcpw_res / 2), dcpw_y + (dcpw_res / 2) + 21, 7.2, 9.8, 0, c_white, 1);
            if (!surface_exists(dlg_color_surface))
            {
                dlg_color_surface = surface_create(dcpw_res, dcpw_res);
                dlg_last_picker_value = -1;
            }
            if (dlg_picker_value != dlg_last_picker_value)
            {
                surface_set_target(dlg_color_surface);
                draw_clear_alpha(c_black, 0);
                for (var _h = 0; _h < dcpw_res; _h += 1)
                {
                    for (var _s = 0; _s < dcpw_res; _s += 1)
                    {
                        var _gc = make_color_hsv(dlg_picker_value, (_h / dcpw_res) * 255, 255 - ((_s / dcpw_res) * 255));
                        draw_set_color(_gc);
                        draw_point(_h, _s);
                    }
                }
                draw_set_color(c_white);
                surface_reset_target();
                dlg_last_picker_value = dlg_picker_value;
            }
            draw_surface(dlg_color_surface, dcpw_x, dcpw_y);
            var _dcp_sat = color_get_saturation(dlg_preview_color);
            var _dcp_val = color_get_value(dlg_preview_color);
            var _dcp_rx = dcpw_x + ((_dcp_sat / 255) * dcpw_res);
            var _dcp_ry = dcpw_y + (((255 - _dcp_val) / 255) * dcpw_res);
            var _neg_r = 255 - color_get_red(dlg_preview_color);
            var _neg_g = 255 - color_get_green(dlg_preview_color);
            var _neg_b = 255 - color_get_blue(dlg_preview_color);
            draw_set_color(make_color_rgb(_neg_r, _neg_g, _neg_b));
            draw_line_width(_dcp_rx - 4, _dcp_ry, _dcp_rx - 1, _dcp_ry, 1);
            draw_line_width(_dcp_rx + 1, _dcp_ry, _dcp_rx + 4, _dcp_ry, 1);
            draw_line_width(_dcp_rx, _dcp_ry - 4, _dcp_rx, _dcp_ry - 1, 1);
            draw_line_width(_dcp_rx, _dcp_ry + 1, _dcp_rx, _dcp_ry + 4, 1);
            draw_set_color(c_white);
            if (mouse_check_button(mb_left) && point_in_rectangle(mouse_x, mouse_y, dcpw_x, dcpw_y, dcpw_x + dcpw_res, dcpw_y + dcpw_res))
            {

        var dlg_wife_hover = point_in_rectangle(mouse_x, mouse_y, dlg_wife_btn_x - 18, dlg_color_y - 1, dlg_wife_btn_x + 18, dlg_color_y + 9);
        draw_set_halign(fa_center);
        draw_sprite_ext(sButtonBack, 1, dlg_futa_btn_x, dlg_color_y + 5, 2.8, 0.9, 0, oDialogueManager.top_dialogue_color, 0.5 + (0.5 * dlg_futa_hover));
        draw_text_ext_transformed_color(dlg_futa_btn_x, dlg_color_y + 3, "futa", 10, 100, 0.5, 0.5, 0, 16777215, 16777215, 16777215, 16777215, 1);
        draw_sprite_ext(sButtonBack, 1, dlg_wife_btn_x, dlg_color_y + 5, 2.8, 0.9, 0, oDialogueManager.wife_dialogue_color, 0.5 + (0.5 * dlg_wife_hover));
        draw_text_ext_transformed_color(dlg_wife_btn_x, dlg_color_y + 3, "wife", 10, 100, 0.5, 0.5, 0, 16777215, 16777215, 16777215, 16777215, 1);

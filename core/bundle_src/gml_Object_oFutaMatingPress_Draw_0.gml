    var _name_box_x = rp_x;
    var _name_box_y = rp_top + 54;
    var _name_box_w = 200;
    var _name_box_h = 27;
    draw_sprite_ext(sButtonBack, 0, _name_box_x, _name_box_y, _name_box_w / 16, _name_box_h / 20, 0, c_white, 0.5);
    var _max_chars = 28;
    var _display_name = _track_name;
    if (string_length(_track_name) > _max_chars)
    {
        _display_name = string_copy(_track_name, 1, _max_chars) + "...";
    }
    draw_set_halign(fa_left);
    draw_text_transformed(rp_x - ((_name_box_w - 12) / 2), _name_box_y - 9, _display_name, 0.8, 0.8, 0);
    draw_set_halign(fa_center);
    var _btn_y = rp_top + 37;
    var _btn_spacing = 16;
    var _btns_total = 5;
    var _btns_start = rp_x - (((_btns_total - 1) * _btn_spacing) / 2);
    var _btn_sprites = [15, 16, radio_is_playing ? 18 : 17, 19];
    _btns_total = 4;
    _btns_start = rp_x - (((_btns_total - 1) * _btn_spacing) / 2);
    for (var _bi = 0; _bi < 4; _bi++)
    {
        var _bx = _btns_start + (_bi * _btn_spacing);
        var _bhover = point_in_rectangle(mouse_x, mouse_y, _bx - 7, _btn_y - 7, _bx + 7, _btn_y + 7);
        draw_sprite_ext(sButtons, _btn_sprites[_bi], _bx, _btn_y, 0.5, 0.5, 0, c_white, 0.5 + (0.5 * _bhover));
        if (_bhover && mouse_check_button_pressed(mb_left))
        {
            if (_bi == 0)
            {
                func_radio_play(radio_track_index - 1);
            }
            else if (_bi == 1)
            {
                func_radio_stop();
            }
            else if (_bi == 2)
            {
                if (radio_is_playing)
                {
                    audio_pause_sound(radio_instance);
                    radio_is_playing = false;
                }
                else if (audio_exists(radio_instance))
                {
                    audio_resume_sound(radio_instance);
                    radio_is_playing = true;
                }
                else
                {
                    func_radio_play(radio_track_index);
                }
            }
            else if (_bi == 3)
            {
                func_radio_play(radio_track_index + 1);
            }
        }
    }
    var _vol_y = rp_top + 80;
    var _vol_label_x = rp_x - 110;
    draw_set_halign(fa_left);
    draw_text_transformed(_vol_label_x, _vol_y - 6, "VOLUME", 0.7, 0.7, 0);
    var _slider_x = rp_x - 70;
    var _slider_right = rp_x + 75;
    var _slider_w = _slider_right - _slider_x;
    var _knob_x = _slider_x + (_slider_w * radio_volume);
    var _vol_knob_hover = point_in_rectangle(mouse_x, mouse_y, _knob_x - 5, _vol_y - 5, _knob_x + 5, _vol_y + 5);
    draw_line_colour(_slider_x, _vol_y, _slider_right, _vol_y, c_gray, c_gray);
    draw_line_colour(_slider_x, _vol_y, _knob_x, _vol_y, c_white, c_white);
    draw_circle_colour(_knob_x, _vol_y, 4, c_white, c_white, false);
    var _vol_pct = string(round(radio_volume * 100)) + "%";
    draw_set_halign(fa_right);
    draw_text_transformed(_slider_right + 30, _vol_y - 6, _vol_pct, 0.7, 0.7, 0);
    draw_set_halign(fa_left);
    if (_vol_knob_hover && mouse_check_button_pressed(mb_left))
    {
        radio_slider_dragging = true;
    }
    if (radio_slider_dragging && mouse_check_button(mb_left))
    {
        radio_volume = clamp((mouse_x - _slider_x) / _slider_w, 0, 1);
        if (audio_exists(radio_instance))
        {
            audio_sound_gain(radio_instance, radio_volume, 0);
        }
    }
    var _seek_y = _vol_y + 22;
    var _seek_x = rp_x - 110;
    var _seek_right = rp_x + 110;
    var _seek_w = _seek_right - _seek_x;
    var _cur_pos = 0;
    var _dur = -1;
    if (audio_exists(radio_instance))
    {
        _cur_pos = audio_sound_get_track_position(radio_instance);
    }
    if (audio_exists(radio_stream))
    {
        _dur = audio_sound_length(radio_stream);
    }
    var _seek_pct = 0;
    if (_dur > 0)
    {
        _seek_pct = clamp(_cur_pos / _dur, 0, 1);
    }
    var _knob_seek_x = _seek_x + (_seek_w * _seek_pct);
    var _seek_knob_hover = point_in_rectangle(mouse_x, mouse_y, _knob_seek_x - 6, _seek_y - 6, _knob_seek_x + 6, _seek_y + 6);
    var _seek_bar_hover = point_in_rectangle(mouse_x, mouse_y, _seek_x, _seek_y - 6, _seek_right, _seek_y + 6);
    draw_line_colour(_seek_x, _seek_y, _seek_right, _seek_y, c_gray, c_gray);
    draw_line_colour(_seek_x, _seek_y, _knob_seek_x, _seek_y, c_white, c_white);
    draw_circle_colour(_knob_seek_x, _seek_y, 4, c_white, c_white, false);
    if ((_seek_knob_hover || _seek_bar_hover) && mouse_check_button_pressed(mb_left))
    {
        radio_seek_dragging = true;
    }
    if (radio_seek_dragging && mouse_check_button(mb_left))
    {
        var _new_pct = clamp((mouse_x - _seek_x) / _seek_w, 0, 1);
        if (_dur > 0 && audio_exists(radio_instance))
        {
            audio_sound_set_track_position(radio_instance, _new_pct * _dur);
        }
    }
    var _fmt_cur_m = string(floor(_cur_pos / 60));
    var _fmt_cur_s = string_format(floor(_cur_pos % 60), 2, 0);
    _fmt_cur_s = string_replace_all(_fmt_cur_s, " ", "0");
    var _fmt_cur = _fmt_cur_m + ":" + _fmt_cur_s;
    var _fmt_dur = "?:??";
    if (_dur > 0)
    {
        var _fmt_dur_m = string(floor(_dur / 60));
        var _fmt_dur_s = string_format(floor(_dur % 60), 2, 0);
        _fmt_dur_s = string_replace_all(_fmt_dur_s, " ", "0");
        _fmt_dur = _fmt_dur_m + ":" + _fmt_dur_s;
    }
    draw_set_halign(fa_left);
    draw_text_transformed(_seek_x, _seek_y + 7, _fmt_cur, 0.65, 0.65, 0);
    draw_set_halign(fa_right);
    draw_text_transformed(_seek_right, _seek_y + 7, _fmt_dur, 0.65, 0.65, 0);
    draw_set_halign(fa_center);
    var _close_hover = point_in_rectangle(mouse_x, mouse_y, rp_right - 14, rp_top + 2, rp_right - 2, rp_top + 14);
    draw_set_halign(fa_center);
    draw_text_transformed(rp_right - 8, rp_top + 3, "X", 0.7, 0.7, 0);
    if (_close_hover && mouse_check_button_pressed(mb_left))
    {
        radio_toggle = false;
    }
    var _shuf_x = rp_x;
    var _shuf_y = _seek_y + 12;
    var _shuf_hover = point_in_rectangle(mouse_x, mouse_y, _shuf_x - 20, _shuf_y - 6, _shuf_x + 20, _shuf_y + 6);
    if (radio_shuffle)
    {
        draw_set_colour(make_colour_rgb(0, 220, 0));
    }
    else if (_shuf_hover)
    {
        draw_set_colour(make_colour_rgb(0, 120, 0));
    }
    else
    {
        draw_set_colour(c_gray);
    }
    draw_text_transformed(_shuf_x, _shuf_y - 5, "SHUFFLE", 0.7, 0.7, 0);
    draw_set_colour(c_white);
    if (_shuf_hover && mouse_check_button_pressed(mb_left))

            var new_y = mouse_y - dlg_drag_offset_y;
            var half_w = (max_lover_dialogue_width * text_scale_l) / 2;
            new_cx = clamp(new_cx, half_w, room_width - half_w);
            new_y = clamp(new_y, 0, room_height - l_h);
            top_dlg_x = new_cx - (room_width / 2);

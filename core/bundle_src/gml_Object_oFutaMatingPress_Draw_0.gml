if (!variable_instance_exists(id, "legacy_xray_sprite"))
{
    legacy_xray_sprite = -1;
}
if (!variable_instance_exists(id, "legacy_custom_xray"))
{
    legacy_custom_xray = -1;
}

if (!variable_instance_exists(id, "boob_box"))
{
    boob_box = false;
}
if (!variable_instance_exists(id, "boob_box"))
{
    boob_box = false;
}
tc_typing = false;
// Master Modal Supremacy & Total Input Isolation Shield
if (variable_instance_exists(id, "futa_selector_open") && futa_selector_open)
{
    pill_menu_toggle = false;
    newlover_menu_toggle = false;
    newwife_menu_toggle = false;
    options_toggle = false;
    actions_menu_toggle = false;
    in_action_menu = false;
    radio_toggle = false;
    cs_toggle = false;
    position_menu_toggle = false;
    background_menu_toggle = false;
    radial_menu_open = false;
    radial_sub_menu = "";
    mob_expanded = false;
    penis_grab = false;
    kiss_box = false;
    headpat_press = false;
    futa_boob_press = false;
    wife_boob_press = false;
}
else if (variable_instance_exists(id, "mob_expanded") && mob_expanded)
{
    pill_menu_toggle = false;
    newlover_menu_toggle = false;
    newwife_menu_toggle = false;
    options_toggle = false;
    actions_menu_toggle = false;
    in_action_menu = false;
    radio_toggle = false;
    cs_toggle = false;
    position_menu_toggle = false;
    background_menu_toggle = false;
    radial_menu_open = false;
    radial_sub_menu = "";
    penis_grab = false;
    kiss_box = false;
    headpat_press = false;
    futa_boob_press = false;
    wife_boob_press = false;
}
if (os_type == os_android || os_type == os_ios)
{
    if (tc_commit == 3)
    {
        keyboard_key_press(vk_enter);
    }
    else if (tc_commit == 1)
    {
        keyboard_key_release(vk_enter);
    }
    if (tc_commit > 0)
    {
        tc_commit--;
    }
    var _tc_sel = -1;
    if (variable_instance_exists(id, "customize_selected_input"))
    {
        _tc_sel = customize_selected_input;
    }
    if (_tc_sel == -1 && variable_instance_exists(id, "active_color_input"))
    {
        if (active_color_input != -1)
        {
            _tc_sel = 1000 + active_color_input;
        }
    }
    if (_tc_sel != -1)
    {
        tc_typing = true;
        var _tc_raw = string_replace_all(keyboard_string, ",", ".");
        var _tc_num = "";
        var _tc_dot = false;
        for (var _tc_i = 1; _tc_i <= string_length(_tc_raw); _tc_i++)
        {
            var _tc_c = ord(string_char_at(_tc_raw, _tc_i));
            if (_tc_c >= 48 && _tc_c <= 57)
            {
                _tc_num += chr(_tc_c);
            }
            else if (_tc_c == 46 && !_tc_dot)
            {
                _tc_num += ".";
                _tc_dot = true;
            }
        }
        if (string_char_at(_tc_num, 1) == ".")
        {
            _tc_num = "0" + _tc_num;
        }
        if (_tc_num == "" && (keyboard_check_pressed(vk_enter) || tc_commit == 3) && tc_edit_for == _tc_sel)
        {
            _tc_num = tc_orig;
        }
        if (_tc_num != keyboard_string)
        {
            keyboard_string = _tc_num;
        }
        if (_tc_sel != tc_edit_for)
        {
            tc_edit_for = _tc_sel;
            tc_orig = keyboard_string;
            keyboard_virtual_show(5, 9, 0, false);
            tc_kbv = true;
            tc_kbv_seen = false;
        }
        else if (tc_kbv && tc_commit == 0)
        {
            if (keyboard_virtual_status())
            {
                tc_kbv_seen = true;
            }
            else if (tc_kbv_seen)
            {
                tc_kbv = false;
                tc_commit = 3;
            }
        }
    }
    else
    {
        tc_edit_for = -1;
        if (tc_kbv)
        {
            keyboard_virtual_hide();
            tc_kbv = false;
        }
    }
}
if ((os_type == os_android || os_type == os_ios) && title == true && pm_dialog == -1 && pm_http == -1)
{
    var _pk_s = max(1, round(room_height / 300));
    var _pk_rows = max(3, floor((room_height - (84 * _pk_s)) / (24 * _pk_s)));
    var _pk_x1 = (room_width / 2) - (170 * _pk_s);
    var _pk_x2 = (room_width / 2) + (170 * _pk_s);
    var _pk_y0 = 40 * _pk_s;
    var _pk_by = room_height - (34 * _pk_s);
    var _pk_first = pm_pick_page * _pk_rows;
    if (pm_pick > 0)
    {
        if (mouse_check_button_pressed(mb_left))
        {
            var _pk_hit = -1;
            for (var _pk_i = 0; _pk_i < _pk_rows; _pk_i++)
            {
                if (point_in_rectangle(mouse_x, mouse_y, _pk_x1, _pk_y0 + (_pk_i * 24 * _pk_s), _pk_x2, _pk_y0 + (_pk_i * 24 * _pk_s) + (21 * _pk_s)))
                {
                    _pk_hit = _pk_first + _pk_i;
                }
            }
            if (_pk_hit >= 0 && _pk_hit < array_length(pm_pick_list))
            {
                if (pm_pick == 3)
                {
                    pm_rm_path = pm_pick_paths[_pk_hit];
                    pm_rm_kind = pm_pick_kinds[_pk_hit];
                    pm_rm_name = pm_pick_list[_pk_hit];
                    pm_pick_list = ["YES - REMOVE IT", "NO - KEEP IT"];
                    pm_pick_paths = ["", ""];
                    pm_pick_kinds = [0, 0];
                    pm_pick_page = 0;
                    pm_pick = 4;
                }
                else if (pm_pick == 4)
                {
                    pm_pick = 0;
                    var _pm_save = game_save_id;
                    if (string_char_at(_pm_save, string_length(_pm_save)) == "/")
                    {
                        _pm_save = string_copy(_pm_save, 1, string_length(_pm_save) - 1);
                    }
                    if (_pk_hit == 0 && string_pos(_pm_save + "/", pm_rm_path) == 1)
                    {
                        pm_registry_remove(pm_rm_path);
                        if (pm_rm_kind == 1)
                        {
                            file_delete(pm_rm_path);
                        }
                        else
                        {
                            var _pm_xq = [pm_rm_path];
                            var _pm_xi = 0;
                            while (_pm_xi < array_length(_pm_xq))
                            {
                                var _pm_xd = _pm_xq[_pm_xi];
                                _pm_xi++;
                                var _pm_xn = [];
                                var _pm_xf = tc_ff_first(_pm_xd + "/*", 16);
                                while (_pm_xf != "")
                                {
                                    if (_pm_xf != "." && _pm_xf != "..")
                                    {
                                        array_push(_pm_xn, _pm_xf);
                                    }
                                    _pm_xf = tc_ff_next();
                                }
                                tc_ff_close();
                                for (var _pm_xk = 0; _pm_xk < array_length(_pm_xn); _pm_xk++)
                                {
                                    if (tc_dir_exists(_pm_xd + "/" + _pm_xn[_pm_xk]))
                                    {
                                        array_push(_pm_xq, _pm_xd + "/" + _pm_xn[_pm_xk]);
                                    }
                                    else
                                    {
                                        file_delete(_pm_xd + "/" + _pm_xn[_pm_xk]);
                                    }
                                }
                            }
                            var _pm_xr = array_length(_pm_xq) - 1;
                            while (_pm_xr >= 0)
                            {
                                directory_destroy(_pm_xq[_pm_xr]);
                                if (tc_dir_exists(_pm_xq[_pm_xr]))
                                {
                                    file_delete(_pm_xq[_pm_xr]);
                                }
                                _pm_xr--;
                            }
                            var _rm_cut = string_pos("/phone_mods/", pm_rm_path);
                            if (_rm_cut > 0)
                            {
                                var _rm_rest = string_delete(pm_rm_path, 1, _rm_cut + 11);
                                if (string_pos("/", _rm_rest) > 0)
                                {
                                    var _rm_top = string_copy(pm_rm_path, 1, _rm_cut + 11) + string_copy(_rm_rest, 1, string_pos("/", _rm_rest) - 1);
                                    var _pm_added = 0;
                                    var _pm_queue = [_rm_top];
                                    var _pm_names = ["mod"];
                                    var _pm_depths = [0];
                                    var _pm_qi = 0;
                                    while (_pm_qi < array_length(_pm_queue))
                                    {
                                        var _pm_dir = _pm_queue[_pm_qi];
                                        var _pm_name = _pm_names[_pm_qi];
                                        var _pm_depth = _pm_depths[_pm_qi];
                                        _pm_qi++;
                                        if (file_exists(_pm_dir + "/custom_data.futa") || file_exists(_pm_dir + "/custom_data.wife") || file_exists(_pm_dir + "/custom_data.spouse") || file_exists(_pm_dir + "/custom_data.bedroom"))
                                        {
                                            _pm_added++;
                                        }
                                        else if (_pm_depth < 4)
                                        {
                                            var _pm_find = tc_ff_first(_pm_dir + "/*", 16);
                                            while (_pm_find != "")
                                            {
                                                if (_pm_find != "." && _pm_find != "..")
                                                {
                                                    array_push(_pm_queue, _pm_dir + "/" + _pm_find);
                                                    array_push(_pm_names, _pm_find);
                                                    array_push(_pm_depths, _pm_depth + 1);
                                                }
                                                _pm_find = tc_ff_next();
                                            }
                                            tc_ff_close();
                                        }
                                    }
                                    if (_pm_added == 0)
                                    {
                                        _pm_xq = [_rm_top];
                                        _pm_xi = 0;
                                        while (_pm_xi < array_length(_pm_xq))
                                        {
                                            var _pm_xd = _pm_xq[_pm_xi];
                                            _pm_xi++;
                                            var _pm_xn = [];
                                            var _pm_xf = tc_ff_first(_pm_xd + "/*", 16);
                                            while (_pm_xf != "")
                                            {
                                                if (_pm_xf != "." && _pm_xf != "..")
                                                {
                                                    array_push(_pm_xn, _pm_xf);
                                                }
                                                _pm_xf = tc_ff_next();
                                            }
                                            tc_ff_close();
                                            for (var _pm_xk = 0; _pm_xk < array_length(_pm_xn); _pm_xk++)
                                            {
                                                if (tc_dir_exists(_pm_xd + "/" + _pm_xn[_pm_xk]))
                                                {
                                                    array_push(_pm_xq, _pm_xd + "/" + _pm_xn[_pm_xk]);
                                                }
                                                else
                                                {
                                                    file_delete(_pm_xd + "/" + _pm_xn[_pm_xk]);
                                                }
                                            }
                                        }
                                        _pm_xr = array_length(_pm_xq) - 1;
                                        while (_pm_xr >= 0)
                                        {
                                            directory_destroy(_pm_xq[_pm_xr]);
                                            if (tc_dir_exists(_pm_xq[_pm_xr]))
                                            {
                                                file_delete(_pm_xq[_pm_xr]);
                                            }
                                            _pm_xr--;
                                        }
                                    }
                                }
                            }
                        }
                        // only report success when the files are really gone (the game never re-checked before)
                        var _rm_left = false;
                        if (pm_rm_kind == 1)
                        {
                            _rm_left = file_exists(pm_rm_path);
                        }
                        else
                        {
                            _rm_left = directory_exists(pm_rm_path) || file_exists(pm_rm_path + "/custom_data.futa") || file_exists(pm_rm_path + "/custom_data.wife") || file_exists(pm_rm_path + "/custom_data.spouse") || file_exists(pm_rm_path + "/custom_data.bedroom");
                        }
                        if (_rm_left)
                        {
                            pm_registry_add(pm_rm_path);
                            pm_status = "Could not delete " + pm_rm_name + ": its files are still on the phone. Nothing was restarted.";
                        }
                        else if (pm_rm_kind == 2)
                        {
                            pm_status = "Removed " + pm_rm_name + ". A lover that was given this voice keeps it.";
                        }
                        else
                        {
                            global.pm_note = "Removed " + pm_rm_name + ".";
                            var _rm_socks = ["tb_sock", "hmv_socket", "buttplug_socket"];
                            for (var _rm_s = 0; _rm_s < 3; _rm_s++)
                            {
                                if (variable_instance_exists(id, _rm_socks[_rm_s]))
                                {
                                    var _rm_sv = variable_instance_get(id, _rm_socks[_rm_s]);
                                    if (is_real(_rm_sv) && _rm_sv >= 0)
                                    {
                                        network_destroy(_rm_sv);
                                    }
                                }
                            }
                            game_restart();
                        }
                    }
                }
                else if (pm_pick == 1)
                {
                    pm_voice_sel = pm_pick_paths[_pk_hit];
                    pm_voice_name = pm_pick_list[_pk_hit];
                    pm_pick_list = [];
                    pm_pick_paths = [];
                    for (var _pk_l = 0; _pk_l < ds_list_size(custom_futas_folder); _pk_l++)
                    {
                        var _pk_lp = ds_list_find_value(custom_futas_folder, _pk_l);
                        var _pk_ln = _pk_lp;
                        while (string_pos("/", _pk_ln) > 0)
                        {
                            _pk_ln = string_delete(_pk_ln, 1, string_pos("/", _pk_ln));
                        }
                        array_push(pm_pick_list, _pk_ln);
                        array_push(pm_pick_paths, _pk_lp);
                    }
                    pm_pick_page = 0;
                    pm_pick = 2;
                    if (array_length(pm_pick_list) == 0)
                    {
                        pm_pick = 0;
                        pm_status = "There are no custom lovers to give a voice to.";
                    }
                }
                else
                {
                    var _pm_save = game_save_id;
                    if (string_char_at(_pm_save, string_length(_pm_save)) == "/")
                    {
                        _pm_save = string_copy(_pm_save, 1, string_length(_pm_save) - 1);
                    }
                    var _pk_dst = pm_pick_paths[_pk_hit];
                    if (string_pos(_pm_save, _pk_dst) != 1)
                    {
                        var _pk_cut = string_pos("phone_mods/", _pk_dst);
                        if (_pk_cut <= 0)
                        {
                            _pk_cut = string_pos("custom_futas/", _pk_dst);
                        }
                        if (_pk_cut > 0)
                        {
                            _pk_dst = _pm_save + "/" + string_copy(_pk_dst, _pk_cut, string_length(_pk_dst));
                        }
                    }
                    var _pk_kinds = ["moan_fast", "moan_slow", "orgasm"];
                    for (var _pk_k = 0; _pk_k < 3; _pk_k++)
                    {
                        var _pk_old = [];
                        var _pk_of = tc_ff_first(_pk_dst + "/" + _pk_kinds[_pk_k] + "/*.ogg", 0);
                        while (_pk_of != "")
                        {
                            array_push(_pk_old, _pk_of);
                            _pk_of = tc_ff_next();
                        }
                        tc_ff_close();
                        for (var _pk_o = 0; _pk_o < array_length(_pk_old); _pk_o++)
                        {
                            file_delete(_pk_dst + "/" + _pk_kinds[_pk_k] + "/" + _pk_old[_pk_o]);
                        }
                    }
                    var _pm_csrc = [pm_voice_sel];
                    var _pm_cdst = [_pk_dst];
                    var _pm_ci = 0;
                    while (_pm_ci < array_length(_pm_csrc))
                    {
                        var _pm_cs = _pm_csrc[_pm_ci];
                        var _pm_cd = _pm_cdst[_pm_ci];
                        _pm_ci++;
                        if (!tc_dir_exists(_pm_cd))
                        {
                            directory_create(_pm_cd);
                        }
                        var _pm_cn = [];
                        var _pm_cf = tc_ff_first(_pm_cs + "/*", 16);
                        while (_pm_cf != "")
                        {
                            if (_pm_cf != "." && _pm_cf != "..")
                            {
                                array_push(_pm_cn, _pm_cf);
                            }
                            _pm_cf = tc_ff_next();
                        }
                        tc_ff_close();
                        for (var _pm_cx = 0; _pm_cx < array_length(_pm_cn); _pm_cx++)
                        {
                            if (tc_dir_exists(_pm_cs + "/" + _pm_cn[_pm_cx]))
                            {
                                array_push(_pm_csrc, _pm_cs + "/" + _pm_cn[_pm_cx]);
                                array_push(_pm_cdst, _pm_cd + "/" + _pm_cn[_pm_cx]);
                            }
                            else
                            {
                                file_copy(_pm_cs + "/" + _pm_cn[_pm_cx], _pm_cd + "/" + _pm_cn[_pm_cx]);
                            }
                        }
                    }
                    pm_status = "Voice " + pm_voice_name + " given to " + pm_pick_list[_pk_hit] + ". Choose that lover again to hear it.";
                    pm_pick = 0;
                }
            }
            else if (point_in_rectangle(mouse_x, mouse_y, _pk_x1, _pk_by, _pk_x1 + (90 * _pk_s), _pk_by + (22 * _pk_s)))
            {
                if (pm_pick_page > 0)
                {
                    pm_pick_page--;
                }
            }
            else if (point_in_rectangle(mouse_x, mouse_y, _pk_x2 - (90 * _pk_s), _pk_by, _pk_x2, _pk_by + (22 * _pk_s)))
            {
                if ((_pk_first + _pk_rows) < array_length(pm_pick_list))
                {
                    pm_pick_page++;
                }
            }
            else if (point_in_rectangle(mouse_x, mouse_y, (room_width / 2) - (50 * _pk_s), _pk_by, (room_width / 2) + (50 * _pk_s), _pk_by + (22 * _pk_s)))
            {
                pm_pick = 0;
            }
            mouse_clear(mb_left);
        }
    }
    else if (mouse_check_button_pressed(mb_left) && point_in_rectangle(mouse_x, mouse_y, 10, room_height - 46, 150, room_height - 18))
    {
        var _pm_save = game_save_id;
        if (string_char_at(_pm_save, string_length(_pm_save)) == "/")
        {
            _pm_save = string_copy(_pm_save, 1, string_length(_pm_save) - 1);
        }
        pm_pick_list = [];
        pm_pick_paths = [];
        var _pk_vf = tc_ff_first(_pm_save + "/phone_voices/*", 16);
        while (_pk_vf != "")
        {
            if (_pk_vf != "." && _pk_vf != "..")
            {
                array_push(pm_pick_list, _pk_vf);
                array_push(pm_pick_paths, _pm_save + "/phone_voices/" + _pk_vf);
            }
            _pk_vf = tc_ff_next();
        }
        tc_ff_close();
        var _pk_reg = pm_registry_read();
        for (var _pk_rg = 0; _pk_rg < array_length(_pk_reg); _pk_rg++)
        {
            if (string_pos("/phone_voices/", _pk_reg[_pk_rg]) > 0 && !array_contains(pm_pick_paths, _pk_reg[_pk_rg]) && tc_dir_exists(_pk_reg[_pk_rg]))
            {
                array_push(pm_pick_list, pm_registry_base(_pk_reg[_pk_rg]));
                array_push(pm_pick_paths, _pk_reg[_pk_rg]);
            }
        }
        pm_pick_page = 0;
        if (array_length(pm_pick_list) == 0)
        {
            pm_status = "No voice packs yet. Add one with ADD MOD.";
        }
        else
        {
            pm_pick = 1;
        }
        mouse_clear(mb_left);
    }
    else if (mouse_check_button_pressed(mb_left) && point_in_rectangle(mouse_x, mouse_y, 10, room_height - 80, 150, room_height - 52))
    {
        pm_pick_list = [];
        pm_pick_paths = [];
        pm_pick_kinds = [];
        var _pm_save = game_save_id;
        if (string_char_at(_pm_save, string_length(_pm_save)) == "/")
        {
            _pm_save = string_copy(_pm_save, 1, string_length(_pm_save) - 1);
        }
        var _rm_root = _pm_save + "/phone_mods";
        var _pm_added = 0;
        var _pm_queue = [_rm_root];
        var _pm_names = ["mod"];
        var _pm_depths = [0];
        var _rm_reg = pm_registry_read();
        for (var _rm_rg = 0; _rm_rg < array_length(_rm_reg); _rm_rg++)
        {
            if (string_pos("/phone_mods/", _rm_reg[_rm_rg]) > 0)
            {
                array_push(_pm_queue, _rm_reg[_rm_rg]);
                array_push(_pm_names, pm_registry_base(_rm_reg[_rm_rg]));
                array_push(_pm_depths, 99);
            }
        }
        var _pm_qi = 0;
        while (_pm_qi < array_length(_pm_queue))
        {
            var _pm_dir = _pm_queue[_pm_qi];
            var _pm_name = _pm_names[_pm_qi];
            var _pm_depth = _pm_depths[_pm_qi];
            _pm_qi++;
            if (file_exists(_pm_dir + "/custom_data.futa") || file_exists(_pm_dir + "/custom_data.wife") || file_exists(_pm_dir + "/custom_data.spouse"))
            {
                var _rm_label = "PARTNER";
                if (file_exists(_pm_dir + "/custom_data.futa"))
                {
                    _rm_label = "LOVER";
                }
                else if (file_exists(_pm_dir + "/custom_data.bedroom"))
                {
                    _rm_label = "BACKGROUND";
                }
                if (!array_contains(pm_pick_paths, _pm_dir))
                {
                    array_push(pm_pick_list, _rm_label + " - " + _pm_name);
                    array_push(pm_pick_paths, _pm_dir);
                    array_push(pm_pick_kinds, 0);
                }
            }
            else if (_pm_depth < 8)
            {
                var _pm_find = tc_ff_first(_pm_dir + "/*", 16);
                while (_pm_find != "")
                {
                    if (_pm_find != "." && _pm_find != ".." && tc_dir_exists(_pm_dir + "/" + _pm_find))
                    {
                        array_push(_pm_queue, _pm_dir + "/" + _pm_find);
                        array_push(_pm_names, _pm_find);
                        array_push(_pm_depths, _pm_depth + 1);
                    }
                    _pm_find = tc_ff_next();
                }
                tc_ff_close();
            }
        }
        var _rm_f = tc_ff_first(_pm_save + "/custom_bedrooms/*", 16);
        while (_rm_f != "")
        {
            if (_rm_f != "." && _rm_f != ".." && tc_dir_exists(_pm_save + "/custom_bedrooms/" + _rm_f) == true)
            {
                array_push(pm_pick_list, "BACKGROUND - " + _rm_f);
                array_push(pm_pick_paths, _pm_save + "/custom_bedrooms/" + _rm_f);
                array_push(pm_pick_kinds, 0);
            }
            _rm_f = tc_ff_next();
        }
        tc_ff_close();
        _rm_f = tc_ff_first(_pm_save + "/custom_stuff/dialogue_packs/*", 16);
        while (_rm_f != "")
        {
            if (_rm_f != "." && _rm_f != ".." && tc_dir_exists(_pm_save + "/custom_stuff/dialogue_packs/" + _rm_f) == false)
            {
                array_push(pm_pick_list, "DIALOGUE - " + _rm_f);
                array_push(pm_pick_paths, _pm_save + "/custom_stuff/dialogue_packs/" + _rm_f);
                array_push(pm_pick_kinds, 1);
            }
            _rm_f = tc_ff_next();
        }
        tc_ff_close();
        _rm_f = tc_ff_first(_pm_save + "/texture_packs/*", 16);
        while (_rm_f != "")
        {
            if (_rm_f != "." && _rm_f != ".." && tc_dir_exists(_pm_save + "/texture_packs/" + _rm_f) == true)
            {
                array_push(pm_pick_list, "TEXTURES - " + _rm_f);
                array_push(pm_pick_paths, _pm_save + "/texture_packs/" + _rm_f);
                array_push(pm_pick_kinds, 0);
            }
            _rm_f = tc_ff_next();
        }
        tc_ff_close();
        _rm_f = tc_ff_first(_pm_save + "/phone_voices/*", 16);
        while (_rm_f != "")
        {
            if (_rm_f != "." && _rm_f != ".." && tc_dir_exists(_pm_save + "/phone_voices/" + _rm_f) == true)
            {
                array_push(pm_pick_list, "VOICE - " + _rm_f);
                array_push(pm_pick_paths, _pm_save + "/phone_voices/" + _rm_f);
                array_push(pm_pick_kinds, 2);
            }
            _rm_f = tc_ff_next();
        }
        tc_ff_close();
        // bedrooms, textures, dialogue and voices recorded by phone imports (when folder listing finds nothing)
        for (var _rm_rg = 0; _rm_rg < array_length(_rm_reg); _rm_rg++)
        {
            var _rm_p = _rm_reg[_rm_rg];
            if (array_contains(pm_pick_paths, _rm_p))
            {
                continue;
            }
            var _rm_n = pm_registry_base(_rm_p);
            if (string_pos("/custom_bedrooms/", _rm_p) > 0 && tc_dir_exists(_rm_p))
            {
                array_push(pm_pick_list, "BACKGROUND - " + _rm_n);
                array_push(pm_pick_paths, _rm_p);
                array_push(pm_pick_kinds, 0);
            }
            else if (string_pos("/texture_packs/", _rm_p) > 0 && tc_dir_exists(_rm_p))
            {
                array_push(pm_pick_list, "TEXTURES - " + _rm_n);
                array_push(pm_pick_paths, _rm_p);
                array_push(pm_pick_kinds, 0);
            }
            else if (string_pos("/phone_voices/", _rm_p) > 0 && tc_dir_exists(_rm_p))
            {
                array_push(pm_pick_list, "VOICE - " + _rm_n);
                array_push(pm_pick_paths, _rm_p);
                array_push(pm_pick_kinds, 2);
            }
            else if (string_pos("/dialogue_packs/", _rm_p) > 0 && file_exists(_rm_p))
            {
                array_push(pm_pick_list, "DIALOGUE - " + _rm_n);
                array_push(pm_pick_paths, _rm_p);
                array_push(pm_pick_kinds, 1);
            }
        }
        pm_pick_page = 0;
        if (array_length(pm_pick_list) == 0)
        {
            pm_status = "Nothing to remove. Only mods added on this phone can be removed.";
        }
        else
        {
            pm_pick = 3;
        }
        mouse_clear(mb_left);
    }
}
if ((os_type == os_android || os_type == os_ios) && title == true && pm_dialog == -1 && pm_http == -1 && mouse_check_button_pressed(mb_left) && point_in_rectangle(mouse_x, mouse_y, room_width - 150, room_height - 46, room_width - 10, room_height - 18))
{
    pm_dialog = get_string_async("Add a mod: paste an https:// link to a .zip, or the path of a .zip / .json on this phone (e.g. /sdcard/Download/mod.zip). Tip: you can also Share a file to this game from your file manager.", "");
    mouse_clear(mb_left);
}
if ((os_type == os_android || os_type == os_ios) && title == true && pm_dialog == -1 && pm_http == -1)
{

comment = "position menu";
if (position_menu_toggle && title == false && start_timer < 1 && futa_selector_open == false && mob_expanded == false)
{
    var _top_has_deepthroat = true;
    if (top_sprite == custom_mating_press)
    {
        _top_has_deepthroat = custom_futa_deepthroat != -1 && sprite_exists(custom_futa_deepthroat);
    }
    else if (top_sprite == legacy_custom_mating_press)
    {
        _top_has_deepthroat = custom_deepthroat != -1 && sprite_exists(custom_deepthroat);
    }
    var _wife_has_deepthroat = legacy_custom_wife_toggle ? (legacy_custom_wife_deepthroat != -1 && sprite_exists(legacy_custom_wife_deepthroat)) : (!custom_wife_toggle || (custom_wife_mating_press != -1 && func_wife_dt_file_cached()));
    var _wife_has_cowgirl = legacy_custom_wife_toggle ? false : (custom_wife_cowgirl != -1 && sprite_exists(custom_wife_cowgirl));
    var _can_deepthroat = _top_has_deepthroat && _wife_has_deepthroat;
    var _can_cowgirl = _wife_has_cowgirl || !custom_wife_toggle;
    var pose_list = [];
    var pose_ids = [];
    array_push(pose_list, "MATING PRESS");
    array_push(pose_ids, 0);
    array_push(pose_list, "REVERSE COWGIRL");
    array_push(pose_ids, 1);
    if (_can_cowgirl)
    {
        array_push(pose_list, "COWGIRL");
        array_push(pose_ids, 2);
    }
    if (_can_deepthroat)
    {
        array_push(pose_list, "DEEPTHROAT");
        array_push(pose_ids, 3);
    }
    var menu_item_h = 12;
    var menu_w = 70;
    var menu_x = room_width - 25;
    var menu_y = room_height - ui_y_offset - 60 - (menu_item_h * array_length(pose_list));
    for (var _pi = 0; _pi < array_length(pose_list); _pi++)
    {
        var item_y = menu_y + (_pi * menu_item_h);
        var item_hover = point_in_rectangle(mouse_x, mouse_y, menu_x - menu_w, item_y - 7, menu_x, item_y + 7);
        var is_selected = sex_position == pose_ids[_pi];
        draw_sprite_ext(sButtonBack, 1, menu_x - (menu_w * 0.5), item_y, menu_w / 16, 0.875, 0, is_selected ? c_purple : c_white, item_hover ? 0.9 : 0.6);
        draw_set_halign(fa_center);
        draw_set_valign(fa_middle);
        draw_set_font(fntFontSmall);
        draw_text_transformed(menu_x - (menu_w * 0.5), item_y, pose_list[_pi], 0.85, 0.85, 0);
        draw_set_font(fntFontBig);
        draw_set_halign(fa_left);
        draw_set_valign(fa_top);
        if (item_hover && mouse_check_button_pressed(mb_left))
        {
            sex_position = pose_ids[_pi];
            position_menu_toggle = false;
            body_jiggle = 0.025;
            if (oBackground.background_id == 3)
            {
                oAudioManager.play_sfx(asset_get_index("StarshipSWITCH"), 1);
            }
            else if (oBackground.background_id == 2)
            {
                oAudioManager.play_sfx(asset_get_index("OfficeSWITCH"), 1);
            }
            else if (oBackground.background_id == 5)
            {
                oAudioManager.play_sfx(asset_get_index("VipSWITCH"), 1);
            }
            else if (oBackground.background_id == 1)
            {
                oAudioManager.play_sfx(asset_get_index("BeachSWITCH"), 1);
            }
            else if (oBackground.background_id == 4)
            {
                oAudioManager.play_sfx(asset_get_index("DungeonSWITCH"), 1);
            }
            else if (oBackground.background_id == 0)
            {
                oAudioManager.play_sfx(asset_get_index("BedroomSWITCH"), 1);
            }
            else
            {
                oAudioManager.play_sfx(sndCloth, 0, 1, 1);
            }
        }
    }
    if (mouse_check_button_pressed(mb_right))
    {
        position_menu_toggle = false;
    }
}
comment = "background menu";
if (background_menu_toggle && futa_selector_open == false && mob_expanded == false)
{
    var default_background_data = ["Bedroom", "Beach", "Office", "Starship", "Dungeon", "VIP Lounge"];
    custom_bg_size = ds_list_size(oBackground.custom_background_folders);
    var _count = max_default_bg + custom_bg_size;
    var _visible = min(_count, 11);
    total_background_amount = _count;
    draw_set_halign(fa_center);
    draw_set_valign(fa_middle);
    // Enhanced Bedroom Panel Touch Scrolling & Momentum Lerp
    var _bg_max_scroll = max(0, total_background_amount - 11);
    var _bg_panel_x1 = room_width - 110;
    var _bg_panel_y1 = 95;
    var _bg_panel_x2 = room_width;
    var _bg_panel_y2 = 120 + (12 * _visible) + 15;
    var _bg_panel_hover = point_in_rectangle(mouse_x, mouse_y, _bg_panel_x1, _bg_panel_y1, _bg_panel_x2, _bg_panel_y2);

    if (_bg_panel_hover)
    {
        if (mouse_wheel_up())
        {
            bg_menu.scroll = max(0, bg_menu.scroll - 1);
        }
        if (mouse_wheel_down())
        {
            bg_menu.scroll = min(_bg_max_scroll, bg_menu.scroll + 1);
        }
    }

    if (!variable_instance_exists(id, "bg_menu_dragging"))
    {
        bg_menu_dragging = false;
        bg_menu_drag_start_y = 0;
        bg_menu_drag_start_scroll = 0;
    }

    if (!variable_instance_exists(id, "bg_menu_click_ok"))
    {
        bg_menu_click_ok = false;
    }
    if (!mouse_check_button(mb_left) && !mouse_check_button_released(mb_left))
    {
        bg_menu_click_ok = false;
    }
    if (mouse_check_button_pressed(mb_left) && _bg_panel_hover)
    {
        bg_menu_dragging = true;
        bg_menu_click_ok = true;
        bg_menu_drag_start_y = mouse_y;
        bg_menu_drag_start_scroll = bg_menu.scroll;
    }
    if (bg_menu_dragging)
    {
        if (mouse_check_button(mb_left))
        {
            if (abs(bg_menu_drag_start_y - mouse_y) > 6)
            {
                bg_menu_click_ok = false;
            }
            var _bg_delta = (bg_menu_drag_start_y - mouse_y) / 12;
            bg_menu.scroll = clamp(bg_menu_drag_start_scroll + _bg_delta, 0, _bg_max_scroll);
        }
        else
        {
            bg_menu_dragging = false;
        }
    }
    bg_menu.scroll = clamp(bg_menu.scroll, 0, _bg_max_scroll);
    bg_menu.scroll_lerp = lerp(bg_menu.scroll_lerp, bg_menu.scroll, 0.35);

    // Clickable Up Arrow with generous touch hitbox
    if (bg_menu.scroll > 0)
    {
        var _up_arrow_x = room_width - 56;
        var _up_arrow_y = 109;
        var _up_hover = point_in_rectangle(mouse_x, mouse_y, _up_arrow_x - 30, _up_arrow_y - 12, _up_arrow_x + 30, _up_arrow_y + 12);
        if (mouse_check_button_pressed(mb_left) && _up_hover)
        {
            bg_menu.scroll = max(0, bg_menu.scroll - 3);
            mouse_clear(mb_left);
        }
        draw_sprite_ext(sButtonArrows, 0, _up_arrow_x - (sprite_get_width(sButtonArrows) / 2), _up_arrow_y, 0.6, 0.6, -90, _up_hover ? c_yellow : c_white, 1);
    }

    // Clickable Down Arrow with generous touch hitbox
    if (bg_menu.scroll < _bg_max_scroll)
    {
        var _dn_arrow_x = room_width - 56;
        var _dn_arrow_y = (120 + (12 * _visible)) - 5;
        var _dn_hover = point_in_rectangle(mouse_x, mouse_y, _dn_arrow_x - 30, _dn_arrow_y - 12, _dn_arrow_x + 30, _dn_arrow_y + 12);
        if (mouse_check_button_pressed(mb_left) && _dn_hover)
        {
            bg_menu.scroll = min(_bg_max_scroll, bg_menu.scroll + 3);
            mouse_clear(mb_left);
        }
        draw_sprite_ext(sButtonArrows, 1, _dn_arrow_x - (sprite_get_width(sButtonArrows) / 2), _dn_arrow_y, 0.6, 0.6, -90, _dn_hover ? c_yellow : c_white, 1);
    }
    for (i = 0; i < _count; i++)
    {
        var _visual_pos = i - bg_menu.scroll_lerp;
        if (_visual_pos <= -1 || _visual_pos >= 11)
        {
            continue;
        }
        var b2_x = room_width - 62;
        var b2_y = 120 + (12 * _visual_pos);
        var button_press = point_in_rectangle(mouse_x, mouse_y, b2_x - 26, b2_y - 5, b2_x + 30, b2_y + 5);
        draw_sprite_ext(sButtonBack, 1, b2_x, b2_y, 4, 1, 0, c_white, 0.5 + (1 * button_press));
        var btn_name = "";
        if (i < max_default_bg)
        {
            btn_name = default_background_data[i];
        }
        else if (i < (max_default_bg + custom_bg_size))
        {
            btn_name = oBackground.custom_background_name_array[i - max_default_bg];
        }
        draw_set_color((oBackground.background_id == i) ? make_color_rgb(180, 140, 255) : c_gray);
        draw_text_transformed(b2_x, b2_y, btn_name, 0.5, 0.5, 0);
        if (mouse_check_button_released(mb_left) && button_press && bg_menu_click_ok)
        {
            var _bg_changed = prev_background_id != i;
            oBackground.background_id = i;
            if (bg_randomize_colors)
            {
                oBackground.func_recolor_bedroom();

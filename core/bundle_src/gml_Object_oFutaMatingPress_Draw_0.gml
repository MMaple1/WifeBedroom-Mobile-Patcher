    var _seg_count = edge_boost_max;
    var _bar_w = 200;
    var _bar_h = 14;
    var _bar_x = (room_width / 2) - (_bar_w / 2);
    var _bar_y = room_height - 36;
    var _seg_w = _bar_w / _seg_count;
    var _filled_segs = floor(edge_hold_charge * _seg_count);
    var _partial = (edge_hold_charge * _seg_count) - _filled_segs;
    draw_set_alpha(0.7);
    draw_set_color(c_black);
    draw_rectangle(_bar_x - 2, _bar_y - 2, _bar_x + _bar_w + 2, _bar_y + _bar_h + 2, false);
    draw_set_alpha(1);
    var _i = 0;
    repeat (_seg_count)
    {
        var _sx = _bar_x + (_i * _seg_w);
        var _t = _i / (_seg_count - 1);
        var _col = make_color_rgb(lerp(0, 160, _t), lerp(200, 0, _t), lerp(60, 220, _t));
        var _fill = 0;
        if (_i < _filled_segs)
        {
            _fill = 1;
        }
        else if (_i == _filled_segs)
        {
            _fill = _partial;
        }
        if (_fill > 0)
        {
            draw_set_alpha(0.9);
            draw_set_color(_col);
            draw_rectangle(_sx + 1, _bar_y, (_sx + (_seg_w * _fill)) - 1, _bar_y + _bar_h, false);
        }
        draw_set_alpha(0.5);
        draw_set_color(c_white);
        draw_rectangle(_sx, _bar_y, (_sx + _seg_w) - 1, _bar_y + _bar_h, true);
        _i += 1;
    }
    draw_set_alpha(1);
    draw_set_font(fntFontBig);
    draw_set_halign(fa_center);
    draw_set_valign(fa_middle);
    draw_set_color(c_white);
    draw_text_transformed(_bar_x + (_bar_w / 2), _bar_y - 10, "EDGE BOOST x" + string(max(1, floor(edge_hold_charge * edge_boost_max))), 0.45, 0.45, 0);

if (pill_menu_toggle && futa_selector_open == false && mob_expanded == false)
{
    var pill_data = [["Premature", "premature_pill"], ["Edge Lover", "edge_lover_pill"], ["Contraceptive", "contraceptive_pill"], ["Mega Sperm", "mega_sperm_pill"], ["Equine Penis", "equine_pill"], ["Knotted Penis", "knotted_pill"], ["Extra Thick", "extra_thick_pill"], ["Diphallia", "diphallia_pill"], ["Ovulation", "ovulation_pill"], ["Stamina", "stamina_pill"], ["Leaky", "leaky_pill"], ["Hyper Breeding", "hyper_breeding_pill"], ["Quickshot", "quickshot_pill"], ["Blockage", "blockage_pill"], ["Deceleration", "reverse_speed_pill"], ["Self Edge", "edge_addict_pill"], ["Pound Town", "pound_town_pill"], ["Livestream", "livestream_pill"], ["Growth Cascade", "growth_cascade_pill"], ["Three Pump Champ", "three_pump_champ_pill"], ["Eggxcelent", "eggxcelent_pill"], ["Savor", "savor_pill"], ["Greedy Womb", "greedy_womb_pill"]];
    var _count = array_length(pill_data);
    total_pill_amount = _count;
    draw_set_halign(fa_center);
    draw_set_valign(fa_middle);
    var pill_rows_per_col = 14;
    var pill_col_width = 64;
    var pill_row_height = 12;
    var pill_start_y = 75;
    for (i = 0; i < _count; i++)
    {
        var _col = i div pill_rows_per_col;
        var _row = i % pill_rows_per_col;
        var b2_x = room_width - 62 - (_col * pill_col_width);
        var b2_y = pill_start_y + (pill_row_height * _row);
        var button_press = point_in_rectangle(mouse_x, mouse_y, b2_x - 26, b2_y - 5, b2_x + 30, b2_y + 5);
        draw_sprite_ext(sButtonBack, 1, b2_x, b2_y, 4, 1, 0, c_white, 0.5 + (1 * button_press));
        var btn_name = pill_data[i][0];
        var var_name = pill_data[i][1];
        var is_active = variable_instance_get(id, var_name);
        var _pill_blocked = radial_manual_ui_mode && (var_name == "premature_pill" || var_name == "edge_lover_pill" || var_name == "quickshot_pill" || var_name == "reverse_speed_pill" || var_name == "edge_addict_pill" || var_name == "pound_town_pill" || var_name == "savor_pill");
        draw_set_color(_pill_blocked ? make_color_rgb(60, 60, 60) : (is_active ? make_color_rgb(180, 140, 255) : c_gray));
        draw_set_alpha(_pill_blocked ? 0.4 : 1);
        draw_text_transformed(b2_x, b2_y, btn_name, 0.5, 0.5, 0);
        draw_set_alpha(1);
        if (!futa_selector_open && !mob_expanded && mouse_check_button_pressed(mb_left) && button_press && !_pill_blocked)
        {
            if (!(orgasm == true && var_name == "blockage_pill"))
            {
                var _was_active = is_active;
                variable_instance_set(id, var_name, !is_active);
                if (_was_active == false && var_name != "livestream_pill")
                {
                    func_top_speak("mystery_effect");
                }
                if (oBackground.background_id == 3)
                {
                    if (!_was_active)
                    {
                        oAudioManager.play_sfx(asset_get_index("StarshipON"), 1);
                    }
                    else
                    {
                        oAudioManager.play_sfx(asset_get_index("StarshipOFF"), 1);
                    }
                }
                else if (oBackground.background_id == 2)
                {
                    if (!_was_active)
                    {
                        oAudioManager.play_sfx(asset_get_index("OfficeON"), 1);
                    }
                    else
                    {
                        oAudioManager.play_sfx(asset_get_index("OfficeOFF"), 1);
                    }
                }
                else if (oBackground.background_id == 5)
                {
                    if (!_was_active)
                    {
                        oAudioManager.play_sfx(asset_get_index("VipON"), 1);
                    }
                    else
                    {
                        oAudioManager.play_sfx(asset_get_index("VipOFF"), 1);
                    }
                }
                else if (oBackground.background_id == 1)
                {
                    if (!_was_active)
                    {
                        oAudioManager.play_sfx(asset_get_index("BeachON"), 1);
                    }
                    else
                    {
                        oAudioManager.play_sfx(asset_get_index("BeachOFF"), 1);
                    }
                }
                else if (oBackground.background_id == 4)
                {
                    if (!_was_active)
                    {
                        oAudioManager.play_sfx(asset_get_index("DungeonON"), 1);
                    }
                    else
                    {
                        oAudioManager.play_sfx(asset_get_index("DungeonOFF"), 1);
                    }
                }
                else if (oBackground.background_id == 0)
                {
                    if (!_was_active)
                    {
                        oAudioManager.play_sfx(asset_get_index("BedroomON"), 1);
                    }
                    else
                    {
                        oAudioManager.play_sfx(asset_get_index("BedroomOFF"), 1);
                    }
                }
            }
        }
    }
    draw_set_color(c_white);
    draw_set_valign(fa_top);
}

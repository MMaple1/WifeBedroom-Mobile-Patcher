            }
            top_boob_jiggle = 3;
            func_top_speak("touch_boobs");
            if (top_sprite == sFutaMatingBunny)
            {
                bunny_money += (10 * top_boob_size * top_quality);
                stat_total_bunny_money += (10 * top_boob_size * top_quality);

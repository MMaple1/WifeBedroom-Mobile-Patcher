            draw_rectangle_color(slider_x, row_txt_y + 1, knob_x, row_txt_y + slider_txt_h, #FF99CC, #FF99CC, #FF99CC, #FF99CC, false);
            draw_circle_color(knob_x, row_txt_y + (slider_txt_h / 2), 3, c_white, c_white, false);
